{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MRU Monitor",
  "mainBinaryName": "mru-monitor",
  "version": "../package.json",
  "identifier": "com.measure.mru",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MRU Monitor",
        "width": 1600,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../Pipeline/": "Pipeline/"
    }
  }
}
